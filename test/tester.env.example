# Copy to ~/.config/sucm-acme-tester/tester.env (chmod 600). Never commit real credentials.
ACME_DIRECTORY=https://sucm-test.example.su.se/acme/directory
# EAB credentials from the /acme-accounts/ portal (hmac key is base64url)
ACME_EAB_KID=
ACME_EAB_HMAC_KEY=
# A domain on the account's allow-list (no wildcards)
ACME_TEST_DOMAIN=host.acmetest.su.se
# Set to "false" or a CA bundle path if sucm-test uses an internal CA
ACME_TLS_VERIFY=true
# Optional second account (separate EAB credentials, activated by an admin) for the isolation tests (L3-01).
# Tests that need it are skipped when these are empty.
ACME_EAB_KID_2=
ACME_EAB_HMAC_KEY_2=
# Optional: URL of a previously issued (valid) order, for tests that need one without issuing.
# A successful `just issue` saves it automatically to last_order_url in the state dir; set it
# here only to override.
ACME_ISSUED_ORDER_URL=
# Optional, opt-in: a throwaway account for the disabled-account lockout test (L3-13).
# Bind the key first (run once while the account is active), then disable the account in the
# admin panel and run `just k l3_13`. Re-enable afterwards.
ACME_DISABLED_KID=
ACME_DISABLED_HMAC_KEY=
