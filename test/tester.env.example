# Copy to ~/.config/sucm-acme-tester/tester.env (chmod 600). Never commit real credentials.
ACME_DIRECTORY=https://sucm-test.example.su.se/acme/directory
# EAB credentials from the /acme-accounts/ portal (hmac key is base64url)
ACME_EAB_KID=
ACME_EAB_HMAC_KEY=
# A domain on the account's allow-list (no wildcards)
ACME_TEST_DOMAIN=host.acmetest.su.se
# Set to "false" or a CA bundle path if sucm-test uses an internal CA
ACME_TLS_VERIFY=true
